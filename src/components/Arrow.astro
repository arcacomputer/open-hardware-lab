---
interface Props {
  diagonal?: boolean;
  class?: string;
}
const { diagonal = false, class: className = '' } = Astro.props;
---

<svg
  class={`arrow ${className}`}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  {diagonal ? (
    <path d="M5 19 19 5M5 5h14v14" />
  ) : (
    <path d="M4 12h15m-6-6 6 6-6 6" />
  )}
</svg>
