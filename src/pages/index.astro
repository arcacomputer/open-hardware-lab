---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import HardwareDiagram from '../components/HardwareDiagram.astro';
const title = 'Arca Open Hardware Lab | Hardware, in the open.';
const description =
  'Independent hardware compatibility research in Santiago, Chile. Real machines, reproducible methods, public evidence. Hardware intake is open.';
const repo = 'https://github.com/arcacomputer/open-hardware-lab';
const methodology = `${repo}/tree/main/methodology`;
const inventory = `${repo}/tree/main/hardware`;
const ledger = `${repo}/tree/main/ledger`;
const intakeEmail =
  'mailto:ohl@arca.computer?subject=Open%20Hardware%20Lab%20intake';
const supportUrl = 'https://buy.stripe.com/aFacN41Lw5oH1BH7G57ss03';
const tracks = [
  {
    id: 'omarchy',
    number: '01',
    title: 'Omarchy compatibility',
    short: 'Omarchy',
    question: 'A clean install is only the beginning.',
    description:
      'What happens when a real machine becomes a daily driver? Follow installation, suspend, graphics, media and updates through repeatable runs.',
    categories: [
      'Installation & boot',
      'Suspend & resume',
      'Graphics & displays',
      'Media & connectivity',
    ],
    symbol: 'terminal',
    note: 'From first boot to everyday use.',
  },
  {
    id: 'linux',
    number: '02',
    title: 'Retail Linux hardware',
    short: 'Retail Linux',
    question: 'Same model. Different machine?',
    description:
      'A model name rarely tells the whole story. Examine exact retail configurations, regional SKUs and the components people can actually buy.',
    categories: [
      'Exact configuration',
      'Regional components',
      'Input & connectivity',
      'Firmware & kernel',
    ],
    symbol: 'board',
    note: 'The configuration is the evidence.',
  },
  {
    id: 'agents',
    number: '03',
    title: 'Agent workstations',
    short: 'Agent workloads',
    question: 'Does it hold up when the work gets real?',
    description:
      'Investigate containers, hosted-agent workflows, local inference where practical, and sustained developer use with bounded, documented workloads.',
    categories: [
      'Containers & virtualization',
      'Sustained thermals',
      'Power behavior',
      'Developer workloads',
    ],
    symbol: 'compute',
    note: 'Useful workloads. Documented limits.',
  },
  {
    id: 'regressions',
    number: '04',
    title: 'Regression watch',
    short: 'Regression watch',
    question: 'It worked yesterday. What changed?',
    description:
      'Keep the hardware in the loop. Repeat runs after firmware, kernel and operating-system updates to make improvements and regressions visible.',
    categories: [
      'Firmware changes',
      'Kernel updates',
      'Repeated test runs',
      'Upstream issue history',
    ],
    symbol: 'cycle',
    note: 'A longer life for every test result.',
  },
];
const stages = [
  {
    number: '01',
    label: 'UNIT',
    title: 'Know the machine.',
    text: 'Register an OHL ID, exact configuration, regional SKU, source, ownership and provider relationship.',
  },
  {
    number: '02',
    label: 'RUN',
    title: 'Ask a useful question.',
    text: 'Choose an operating system and a bounded test. Record the method, versions and conditions.',
  },
  {
    number: '03',
    label: 'REPORT',
    title: 'Show the evidence.',
    text: 'Publish privacy-scrubbed observations, failures, workarounds, expenses and upstream links.',
  },
  {
    number: '04',
    label: 'RETEST',
    title: 'Keep asking.',
    text: 'Run it again after firmware, kernel and operating-system changes. A result is a record, not a lifetime verdict.',
  },
];
---

<Layout {title} {description}>
  <Header />
  <main id="main-content">
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="crosshair" aria-hidden="true">
            +
          </span>{' '}
          Independent research. Real machines.
        </p>
        <h1 id="hero-title">
          <span>Hardware,</span>
          <span>
            in the <em>open.</em>
          </span>
        </h1>
        <p class="hero-description">
          What works. What breaks. What changes.
          <br />
          We test hardware in Santiago and publish the evidence for everyone.
        </p>
        <div class="hero-actions">
          <a class="button" href="#tracks">
            Explore the research <Arrow />
          </a>
          <a class="text-link" href="#partners">
            Offer hardware <Arrow diagonal />
          </a>
        </div>
        <div class="hero-location mono">
          <span class="status-dot" aria-hidden="true"></span> SANTIAGO, CHILE{' '}
          <span class="location-divider">/</span> NODE 001
        </div>
      </div>
      <HardwareDiagram />
    </section>
    <section id="lab" class="lab-status" aria-labelledby="lab-title">
      <div class="wrap status-inner">
        <div class="status-intake">
          <span class="status-dot" aria-hidden="true"></span>
          <div>
            <h2 id="lab-title">Hardware intake open</h2>
            <p>Building the public inventory.</p>
          </div>
          <a href="#partners" aria-label="How to offer hardware">
            <Arrow diagonal />
          </a>
        </div>
        <dl class="status-numbers">
          <div>
            <dt>Public units</dt>
            <dd>00</dd>
          </div>
          <div>
            <dt>Active runs</dt>
            <dd>00</dd>
          </div>
          <div>
            <dt>Published reports</dt>
            <dd>00</dd>
          </div>
        </dl>
        <a class="status-register text-link" href={inventory}>
          View the register <Arrow diagonal />
        </a>
      </div>
    </section>
    <section
      class="wrap introduction section-space"
      aria-labelledby="open-title"
    >
      <div class="section-index">
        <span class="mono">01 / THE PRINCIPLE</span>
        <span class="small-cross" aria-hidden="true">
          +
        </span>
      </div>
      <div class="intro-grid">
        <h2 id="open-title">
          A machine is a<br />
          starting point.
          <br />
          <span class="muted-heading">Evidence is the work.</span>
        </h2>
        <div class="intro-copy">
          <h3>What “open” means here</h3>
          <p>
            The process is open: methodology, provenance, disclosures, evidence,
            expenses and upstream work. We don’t claim that every computer we
            test is open hardware.
          </p>
          <p>
            One machine can answer many questions, across operating systems and
            years. Test locally. Publish globally.
          </p>
          <a
            class="text-link"
            href={`${repo}/blob/main/governance/independence.md`}
          >
            Read our independence policy <Arrow diagonal />
          </a>
        </div>
      </div>
    </section>
    <section
      id="tracks"
      class="research-section section-space"
      aria-labelledby="research-title"
    >
      <div class="wrap">
        <div class="section-index">
          <span class="mono">02 / RESEARCH DIRECTIONS</span>
          <span class="mono">FOUR OPEN TRACKS</span>
        </div>
        <div class="section-heading">
          <h2 id="research-title">
            Better questions.
            <br />
            Useful answers.
          </h2>
          <p>
            Compatibility goes beyond a spec sheet.
            <br />
            These are the questions shaping our queue.
          </p>
        </div>
        <div class="research-explorer" data-research-explorer>
          <div
            class="track-selector"
            role="tablist"
            aria-label="Research tracks"
            aria-orientation="vertical"
            hidden
          >
            {tracks.map((track, i) => (
              <button
                id={`tab-${track.id}`}
                class="track-tab"
                type="button"
                role="tab"
                aria-controls={`track-${track.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="track-number mono">{track.number}</span>
                <span>{track.short}</span>
                <Arrow />
              </button>
            ))}
          </div>
          <div class="track-panels">
            {tracks.map((track) => (
              <section
                id={`track-${track.id}`}
                class="track-panel"
                data-track-panel
                aria-labelledby={`track-title-${track.id}`}
              >
                <div class="track-panel-top">
                  <span class="mono">
                    {track.number} / {track.title}
                  </span>
                  <span class="queue-label mono">IN THE QUEUE</span>
                </div>
                <div class="track-symbol" aria-hidden="true">
                  {track.symbol === 'terminal' && (
                    <svg viewBox="0 0 160 100" fill="none">
                      <rect x="15" y="10" width="130" height="80" rx="4" />
                      <path d="M15 29h130M25 20h4m6 0h4m6 0h4M39 47l17 13-17 13m32 0h36" />
                      <path
                        class="symbol-accent"
                        d="m39 47 17 13-17 13m32 0h36"
                      />
                    </svg>
                  )}
                  {track.symbol === 'board' && (
                    <svg viewBox="0 0 160 100" fill="none">
                      <rect x="25" y="10" width="110" height="80" rx="4" />
                      <path d="M48 10v16h16m71 40h-29v-8M48 90V73h13M25 44h37m34-34v18M79 74v16" />
                      <rect
                        class="symbol-accent"
                        x="62"
                        y="31"
                        width="36"
                        height="36"
                      />
                      <path d="M110 22h12v19h-12zM35 57h12v13H35z" />
                    </svg>
                  )}
                  {track.symbol === 'compute' && (
                    <svg viewBox="0 0 160 100" fill="none">
                      <path d="m80 10 50 28-50 29-50-29 50-28Zm-50 44 50 29 50-29M30 70l50 29 50-29" />
                      <path
                        class="symbol-accent"
                        d="m80 10 50 28-50 29-50-29 50-28Z"
                      />
                      <path d="M80 67v32" />
                    </svg>
                  )}
                  {track.symbol === 'cycle' && (
                    <svg viewBox="0 0 160 100" fill="none">
                      <path d="M117 34A40 40 0 0 0 43 30M43 66a40 40 0 0 0 74 4" />
                      <path
                        class="symbol-accent"
                        d="M117 12v23H94M43 89V66h23"
                      />
                      <path d="m66 50 10 10 21-23" />
                    </svg>
                  )}
                  <span class="mono">{track.note}</span>
                </div>
                <h3 id={`track-title-${track.id}`}>{track.question}</h3>
                <p>{track.description}</p>
                <ul class="track-categories">
                  {track.categories.map((category) => (
                    <li>{category}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
        <p class="research-note mono">
          TRACKS ARE RESEARCH DIRECTIONS. THEY DO NOT GUARANTEE A TEST, SCHEDULE
          OR PUBLICATION.
        </p>
      </div>
    </section>
    <section
      id="work"
      class="wrap method-section section-space"
      aria-labelledby="method-title"
    >
      <div class="section-index">
        <span class="mono">03 / THE METHOD</span>
        <a class="text-link mono" href={methodology}>
          READ THE METHODOLOGY <Arrow diagonal />
        </a>
      </div>
      <div class="section-heading">
        <h2 id="method-title">
          Every result
          <br />
          has a paper trail.
        </h2>
        <p>
          Units, runs, reports, retests.
          <br />A record you can follow. A method you can repeat.
        </p>
      </div>
      <ol class="method-steps">
        {stages.map((stage) => (
          <li>
            <div class="step-top">
              <span class="step-number">{stage.number}</span>
              <Arrow />
            </div>
            <span class="mono step-label">{stage.label}</span>
            <h3>{stage.title}</h3>
            <p>{stage.text}</p>
          </li>
        ))}
      </ol>
      <div class="method-footnote">
        <span class="mono">METHOD STATUS</span>
        <p>
          Baseline categories and evidence rules are published. Executable test
          definitions will be added before the first public run.
        </p>
      </div>
    </section>
    <section
      id="ledger"
      class="register-section section-space"
      aria-labelledby="register-title"
    >
      <div class="wrap register-grid">
        <div class="register-copy">
          <span class="mono">04 / THE PUBLIC RECORD</span>
          <h2 id="register-title">
            Nothing hidden.
            <br />
            Nothing invented.
          </h2>
          <p>
            The lab starts empty, not imaginary. No physical unit has been
            accepted into the public register yet.
          </p>
          <p>
            Hardware intake is open. The method is taking shape. This is where
            the evidence will go.
          </p>
          <a class="text-link" href={repo}>
            Follow the work on GitHub <Arrow diagonal />
          </a>
        </div>
        <div class="register-table-wrap">
          <div class="register-caption mono">
            <span>OHL / REGISTER INDEX</span>
            <span>PUBLIC</span>
          </div>
          <table class="register-table">
            <caption class="sr-only">
              Current Open Hardware Lab records and status
            </caption>
            <thead>
              <tr>
                <th scope="col">Record</th>
                <th scope="col">State</th>
                <th scope="col">
                  <span class="sr-only">Source</span>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">
                  Hardware inventory<small>Provenance & custody</small>
                </th>
                <td>
                  <span class="record-state">Awaiting units</span>
                </td>
                <td>
                  <a href={inventory} aria-label="Open hardware inventory">
                    <Arrow diagonal />
                  </a>
                </td>
              </tr>
              <tr>
                <th scope="row">
                  Baseline methodology
                  <small>Test categories & evidence rules</small>
                </th>
                <td>
                  <span class="record-state ready">Published</span>
                </td>
                <td>
                  <a href={methodology} aria-label="Open baseline methodology">
                    <Arrow diagonal />
                  </a>
                </td>
              </tr>
              <tr>
                <th scope="row">
                  Reports & retests
                  <small>Results, failures & upstream work</small>
                </th>
                <td>
                  <span class="record-state">Awaiting runs</span>
                </td>
                <td>
                  <a
                    href={`${repo}/tree/main/reports`}
                    aria-label="Open reports and retests"
                  >
                    <Arrow diagonal />
                  </a>
                </td>
              </tr>
              <tr>
                <th scope="row">
                  Lab ledger<small>Support, expenses & allocations</small>
                </th>
                <td>
                  <span class="record-state ready">Policy published</span>
                </td>
                <td>
                  <a href={ledger} aria-label="Open lab ledger">
                    <Arrow diagonal />
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
          <p class="register-note mono">
            CURRENT PUBLISHED STATE · MAINTAINED IN THE REPOSITORY
          </p>
        </div>
      </div>
    </section>
    <section
      id="partners"
      class="wrap contribute-section section-space"
      aria-labelledby="contribute-title"
    >
      <div class="section-index">
        <span class="mono">05 / MAKE THE WORK POSSIBLE</span>
        <span class="small-cross" aria-hidden="true">
          +
        </span>
      </div>
      <div class="section-heading">
        <h2 id="contribute-title">
          Put hardware
          <br />
          to public use.
        </h2>
        <p>
          Have a machine worth investigating?
          <br />
          Help turn it into a reproducible record.
        </p>
      </div>
      <div class="intake-layout">
        <div class="intake-intro">
          <span class="label mono">Hardware pool</span>
          <h3>
            There’s more than
            <br />
            one way in.
          </h3>
          <p>
            Owned machines, approved loans, permanent placements and retail
            purchases enter the same public inventory.
          </p>
          <p>
            We select work from available hardware, funds, research value and
            lab capacity. Campaigns are optional procurement tools.
          </p>
          <a class="button" href={intakeEmail}>
            Offer hardware <Arrow diagonal />
          </a>
        </div>
        <div class="intake-options">
          <article>
            <span class="mono">01</span>
            <div>
              <h3>Temporary loan</h3>
              <p>
                A bounded research loan with arrival condition, disclosed
                ownership, return date and prepaid return logistics.
              </p>
            </div>
            <Arrow diagonal />
          </article>
          <article>
            <span class="mono">02</span>
            <div>
              <h3>Permanent placement</h3>
              <p>
                Ownership transfers to Arca Computer, Inc. The machine stays in
                the inventory for long-term regression testing.
              </p>
            </div>
            <Arrow diagonal />
          </article>
          <article>
            <span class="mono">03</span>
            <div>
              <h3>Retail delivery</h3>
              <p>
                Fund or supply an exact unit through an approved retailer or
                distributor, with warranty and customs responsibilities
                resolved.
              </p>
            </div>
            <Arrow diagonal />
          </article>
        </div>
      </div>
      <details class="intake-details">
        <summary>
          <span>
            <span class="status-dot" aria-hidden="true"></span> Before anything
            ships
          </span>
          <span class="details-plus" aria-hidden="true">
            +
          </span>
        </summary>
        <div class="intake-detail-content">
          <p>
            Get written intake approval first. Send the model, exact
            configuration, location, ownership proposal and shipping plan to{' '}
            <a href={intakeEmail}>ohl@arca.computer</a>. International intake
            must resolve shipping, customs, warranty and return
            responsibilities; local distribution or DDP is preferred.
          </p>
          <p>
            The unit must have clear research value, workable logistics and a
            publicly disclosed relationship. No favorable-result or
            editorial-control conditions are accepted. A suggestion does not
            guarantee an operating system, schedule, report or positive result.
          </p>
        </div>
      </details>
    </section>
    <section id="fund" class="fund-section" aria-labelledby="fund-title">
      <div class="wrap">
        <div id="support-thanks" class="support-thanks" role="status" hidden>
          <strong>Thank you for supporting open research.</strong>
          <span>
            If your payment completed, Stripe will send a receipt to the email
            used at checkout.
          </span>
        </div>
        <div class="fund-inner">
          <div class="fund-copy">
            <span class="mono">Lab fund / voluntary support</span>
            <h2 id="fund-title">
              Fund the work.
              <br />
              <span>Free the findings.</span>
            </h2>
            <p>
              Help cover equipment, testing and public evidence.
              <br />
              General support stays in the unallocated OHL pool until a specific
              use is published.
            </p>
            <a class="text-link" href={ledger}>
              Follow the money <Arrow diagonal />
            </a>
          </div>
          <div class="fund-action">
            <span class="mono">ONE-TIME SUPPORT · USD</span>
            <div class="support-amount">
              Your call<span aria-hidden="true">↗</span>
            </div>
            <p>You choose the amount at checkout.</p>
            <a
              class="button button-lime"
              href={supportUrl}
              rel="external nofollow"
            >
              Support with Stripe <Arrow diagonal />
            </a>
            <a class="terms-link" href="/support-terms/">
              Read the support terms
            </a>
            <p class="fund-disclosure">
              Voluntary support to Arca Computer, Inc. Not a charitable
              contribution or tax-deductible. No goods, services, reserved tests
              or promised results.
            </p>
          </div>
        </div>
        <div class="independence-line">
          <span class="independence-symbol" aria-hidden="true">
            ↗
          </span>
          <p>
            <strong>Our independence isn’t for sale.</strong> No paid verdicts.
            No editorial approval. No removal of legitimate failures. Support
            buys lab capacity, never a conclusion.
          </p>
          <a
            href={`${repo}/blob/main/governance/independence.md`}
            aria-label="Read the research independence policy"
          >
            <Arrow diagonal />
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
