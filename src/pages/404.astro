---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Not found — Arca Open Hardware Lab"
  description="This page does not exist."
>
  <Header />
  <main id="main-content" class="wrap error-page">
    <div class="mono">404 · Wrong branch</div>
    <h1>Nothing compiled here.</h1>
    <p class="lead">The page you requested is not part of this build.</p>
    <a class="button" href="/">
      Return to the lab
    </a>
  </main>
  <Footer />
</Layout>
